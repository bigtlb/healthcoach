CREATE TABLE weightEntry (
    id TEXT PRIMARY KEY NOT NULL,
    -- Date format is ISO-8601 YYYY-MM-DD
    date TEXT NOT NULL,
    -- weight is always stored in Kg
    weight REAL NOT NULL,
    updated_at INTEGER NOT NULL
);

insert:
INSERT INTO weightEntry (id, date, weight, updated_at) VALUES (?, ?, ?, ?);

update:
UPDATE weightEntry SET date = ?, weight = ?, updated_at = ? WHERE id = ?;

delete:
DELETE FROM weightEntry WHERE id = ?;

selectByDateRange:
SELECT * FROM weightEntry WHERE date >= ? AND date <= ?;

selectAll:
SELECT * FROM weightEntry;

selectById:
SELECT * FROM weightEntry WHERE id = ?;