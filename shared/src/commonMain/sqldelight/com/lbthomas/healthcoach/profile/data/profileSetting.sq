CREATE TABLE profileSetting (
    key TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

insertOrUpdate:
INSERT INTO profileSetting (key, value, updated_at)
VALUES (?, ?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at;

selectByKey:
SELECT * FROM profileSetting WHERE key = ?;

selectAll:
SELECT * FROM profileSetting;

delete:
DELETE FROM profileSetting WHERE key = ?;
