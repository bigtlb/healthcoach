<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
    <id>com.lbthomas.healthcoach</id>
    <name>HealthCoach</name>
    <summary>Health and wellness tracking app</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>Apache-2.0</project_license>
    <supports>
        <control>pointing</control>
        <control>keyboard</control>
        <control>touch</control>
    </supports>
    <description>
        <p>
            HealthCoach is a modern, local-first personal health management and analytics application. Designed to maximize user empowerment, health insight, and day-to-day tracking efficiency, HealthCoach gives you total control over your health metrics, with compound multi-axis charts, and seamless cross-device synchronization.
        </p>
    </description>
    <launchable type="desktop-id">com.lbthomas.healthcoach.desktop</launchable>
    <url type="homepage">https://bigtlb.github.io/healthcoach/</url>
    <url type="bugtracker">https://github.com/bigtlb/healthcoach/issues</url>
    <provides>
        <binary>HealthCoach</binary>
    </provides>
    <developer id="com.lbthomas">
        <name>Thomas Baker</name>
    </developer>
    <content_rating type="oars-1.1" />
    <screenshots>
        <screenshot type="default">
            <caption>Weight entry screen with adaptive graph view</caption>
